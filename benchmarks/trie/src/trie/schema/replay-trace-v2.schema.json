{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sgl-project/sglang/benchmark/trie/schema/replay-trace-v2.schema.json",
  "title": "Trie ReplayTrace schema v2",
  "type": "object",
  "required": ["schema_version", "trace_id", "events"],
  "properties": {
    "schema_version": {"const": 2},
    "trace_id": {"type": "string", "minLength": 1},
    "start_offset_s": {"type": "number", "minimum": 0},
    "initial_messages": {
      "type": "array",
      "items": {"$ref": "#/$defs/message"}
    },
    "tools": {
      "type": ["array", "null"],
      "items": {"type": "object"}
    },
    "metadata": {
      "type": "object",
      "properties": {
        "routing_key": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/append_message"},
          {"$ref": "#/$defs/wait"},
          {"$ref": "#/$defs/generate"},
          {"$ref": "#/$defs/replace_context"}
        ]
      }
    }
  },
  "additionalProperties": false,
  "allOf": [{
    "if": {
      "required": ["metadata"],
      "properties": {"metadata": {
        "required": ["control_only"],
        "properties": {"control_only": {"const": true}}
      }}
    },
    "then": {"properties": {"events": {"items": {"$ref": "#/$defs/wait"}}}},
    "else": {"properties": {"events": {"contains": {"$ref": "#/$defs/generate"}}}}
  }],
  "$defs": {
    "message": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "token_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    },
    "block_runs": {
      "type": "array",
      "minItems": 1,
      "$comment": "[first_block_id, count] pairs; expanded with metadata.block_tokens.",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "integer", "minimum": 0},
          {"type": "integer", "minimum": 1}
        ],
        "minItems": 2,
        "items": false
      }
    },
    "append_message": {
      "type": "object",
      "required": ["type", "message"],
      "properties": {
        "type": {"const": "append_message"},
        "message": {"$ref": "#/$defs/message"}
      },
      "additionalProperties": false
    },
    "wait": {
      "type": "object",
      "required": ["type", "seconds"],
      "properties": {
        "type": {"const": "wait"},
        "seconds": {"type": "number", "minimum": 0},
        "actor": {"enum": ["user", "tool", "other"]}
      },
      "additionalProperties": false
    },
    "generate": {
      "type": "object",
      "required": ["type", "max_tokens"],
      "properties": {
        "type": {"const": "generate"},
        "max_tokens": {"type": "integer", "minimum": 1},
        "recorded_assistant": {
          "allOf": [
            {"$ref": "#/$defs/message"},
            {
              "type": "object",
              "properties": {"role": {"const": "assistant"}}
            }
          ]
        },
        "recorded_prompt_token_ids": {"$ref": "#/$defs/token_ids"},
        "recorded_prompt_token_count": {"type": "integer", "minimum": 1},
        "recorded_prompt_token_ids_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recorded_output_token_ids": {
          "type": "array",
          "minItems": 1,
          "$comment": "The array length must equal max_tokens.",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "source_request_id": {"type": "string", "minLength": 1},
        "source_model": {"type": "string"},
        "source_timestamp": {"type": "string"},
        "recorded_prompt_block_runs": {"$ref": "#/$defs/block_runs"},
        "recorded_output_block_runs": {"$ref": "#/$defs/block_runs"},
        "source_t_s": {"type": "number", "minimum": 0},
        "source_api_time_s": {"type": "number", "minimum": 0},
        "recorded_image_data": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "description": "Image data URIs or client-side files relative to metadata.image_root, ordered by prompt placeholders. The client uploads image contents."
        }
      },
      "dependentRequired": {
        "recorded_prompt_token_count": ["recorded_prompt_token_ids_sha256"],
        "recorded_prompt_token_ids_sha256": ["recorded_prompt_token_count"]
      },
      "additionalProperties": false
    },
    "replace_context": {
      "type": "object",
      "required": ["type", "messages"],
      "properties": {
        "type": {"const": "replace_context"},
        "messages": {
          "type": "array",
          "items": {"$ref": "#/$defs/message"}
        },
        "reason": {"enum": ["compaction", "reset", "branch", "other"]}
      },
      "additionalProperties": false
    }
  }
}
