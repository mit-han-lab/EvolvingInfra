{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sgl-project/sglang/benchmark/trie/schema/replay-task-v3.schema.json",
  "title": "Trie multi-agent ReplayTask schema v3",
  "type": "object",
  "required": [
    "schema_version",
    "trace_id",
    "traces",
    "dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": 3,
      "type": "integer"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "start_offset_s": {
      "type": "number",
      "minimum": 0
    },
    "metadata": {
      "type": "object"
    },
    "cache_salt_scope": {
      "enum": [
        "agent",
        "task"
      ]
    },
    "traces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://github.com/sgl-project/sglang/benchmark/trie/schema/replay-trace-v2.schema.json"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "before",
          "after"
        ],
        "properties": {
          "before": {
            "$ref": "#/$defs/event_ref"
          },
          "after": {
            "$ref": "#/$defs/event_ref"
          },
          "when": {
            "enum": [
              "complete",
              "start"
            ],
            "default": "complete"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "event_ref": {
      "type": "object",
      "required": [
        "trace_id",
        "event_index"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "event_index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
